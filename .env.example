# ==========================================================
# AI Job Skill Gap Analyzer — environment template
# Copy to .env and fill in real values. Never commit .env.
# ==========================================================

# ---------- API settings (prefix API_, see app/core/config.py) ----------
API_DEBUG=false
# Comma-separated allowed origins. Leave empty to disable CORS.
API_CORS_ORIGINS=http://localhost:3000
API_MAX_UPLOAD_SIZE_MB=10
API_UPLOAD_DIR=data/uploads

# ---------- Search parameters ----------
KEYWORD=Backend Developer
LOCATION=Egypt
TARGET_LEVEL=Junior
TARGET_ROLE=Any

# ---------- Scraping behavior ----------
SCRAPER_HEADLESS=true
SCRAPER_NETWORK_IDLE=true
# Delay range (seconds) between description fetches
MIN_DELAY=4.5
MAX_DELAY=8.7
CHECKPOINT_INTERVAL=5

# ---------- Summarization models ----------
PRIMARY_SUMMARIZER=allenai/led-base-16384
FALLBACK_SUMMARIZER=facebook/bart-large-cnn
# Memory-constrained escape hatch: skip local HF summarizer entirely
SKIP_HF_SUMMARIZER=false

# ---------- Local language model ----------
LLM_MODEL=microsoft/Phi-3-mini-4k-instruct
LLM_USE_4BIT=false
LLM_MAX_NEW_TOKENS=2560

# ---------- External LLM provider ----------
# One of: nvidia | openai | anthropic | google | azure | custom
LLM_PROVIDER=nvidia
# Explicit opt-in before CV/job data is sent to any external AI provider
ALLOW_EXTERNAL_AI=false

# Secrets — never commit real values
NVIDIA_API_KEY=
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-70b-instruct

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Custom OpenAI-compatible endpoint
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
